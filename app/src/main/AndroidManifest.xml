<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MyLibrary declares no permissions at all.

      It works entirely through the Storage Access Framework and content:// URIs, so it needs no
      storage permission: a user grants access to individual books or folders through the system
      picker. READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE are deliberately absent.

      INTERNET used to be declared here and has been removed: nothing in the app reaches the
      network. Books are read from local content:// URIs and covers are loaded from cacheDir by
      Coil, which has no network fetcher on its classpath. Asking for a permission the app never
      uses asks the user to trust a claim it cannot keep.
    -->

    <application
        android:name=".MyLibraryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyLibrary"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyLibrary"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              MyLibrary registers as a viewer for every document format it can decode, so a book can
              be opened straight from a file manager, a browser download or another app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/vnd.comicbook-rar" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              The launcher shortcut's own action. An implicit intent with a custom action, resolved
              through this filter so the shortcut names no package — which the debug build's `.debug`
              application id would make wrong.
            -->
            <intent-filter>
                <action android:name="com.mylibrary.action.OPEN_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>

</manifest>
