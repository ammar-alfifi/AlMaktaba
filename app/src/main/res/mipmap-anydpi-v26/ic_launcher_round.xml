<?xml version="1.0" encoding="utf-8"?>
<!--
  The round variant. It draws the same three layers as the square one: on API 26+ the launcher masks
  the icon to its own shape anyway, so a round-specific artwork would be a second design to keep in
  step for no visible difference — the mask, not the file, is what makes it round.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
