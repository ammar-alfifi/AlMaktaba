<?xml version="1.0" encoding="utf-8"?>
<!--
  Arabic is the default locale: this file is the unqualified `values/` resource folder, so an
  Arabic UI is what every user gets unless their device (or an in-app choice) asks for something
  else. `values-en/` holds the complete English translation.

  Every string here is referenced in code — the app module renders only the chrome the features
  don't: the launcher destination labels, the cold-open failure notice and the app name. The
  per-screen vocabulary lives with the screens that render it; `cd_previous_page` and
  `cd_next_page` are the one exception, kept here awaiting the tap-zone a11y pass.
-->
<resources>
    <string name="app_name">مكتبتي</string>

    <!-- Bottom navigation / navigation rail destinations -->
    <string name="nav_library">المكتبة</string>
    <string name="nav_search">البحث</string>
    <string name="nav_settings">الإعدادات</string>

    <!-- Opening a book sent by another app -->
    <string name="app_open_file_failed">تعذّر إضافة هذا الملف إلى المكتبة. الصيغة غير مدعومة أو الملف غير متاح.</string>

    <!-- Content descriptions -->
    <string name="cd_previous_page">الصفحة السابقة</string>
    <string name="cd_next_page">الصفحة التالية</string>

    <!-- Launcher shortcut -->
    <string name="shortcut_search_short">بحث</string>
    <string name="shortcut_search_long">ابحث في مكتبتك</string>
</resources>
