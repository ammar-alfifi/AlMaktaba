<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window background behind the first Compose frame.

      It **must** equal `LightColors.background` in `:core:core-ui` (`#F5FBF8`). It previously did
      not (`#FBFDFA`), so a cold start painted a slightly different white than the app then settled
      on — a visible flicker on exactly the launch path the startup tests cover, and one that only
      shows up in a screenshot comparison because the two values are a couple of percent apart.
    -->
    <color name="window_background">#F5FBF8</color>

    <!--
      The launcher icon's backdrop colour, kept as the icon's base tone. The adaptive icon draws its
      background from a gradient drawable instead — see `drawable/ic_launcher_background.xml` — but a
      colour is still needed for surfaces that read one directly.
    -->
    <color name="ic_launcher_background">#0B4C55</color>
</resources>
