<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons: the system recolours these paths into the user's
  wallpaper palette, so the mark has to survive losing every colour it has.

  The star is left out deliberately. Themed icons are drawn as a single tint at small sizes, and two
  overlapping squares at watermark opacity would resolve into an indistinct blob behind the book —
  the book alone is the shape that stays legible when the only thing carrying the mark is its
  silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M53,42 C47,37 39,34.5 29,36.5 L29,70 C39,68 47,70.5 53,75 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,42 C61,37 69,34.5 79,36.5 L79,70 C69,68 61,70.5 55,75 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M64,44.5 L73,46 L73,63.5 L68.5,59.8 L64,62.8 Z" />
</vector>
