<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons: the system recolours these paths into the user's
  wallpaper palette, so the mark has to survive losing every colour it has.

  It is the same two pages as the foreground — one mark, drawn once, recoloured by the system. A
  themed icon and the ordinary one are therefore the same drawing in two palettes, and cannot
  drift apart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,36 Q39.5,39.5 52,44 L52,64 Q39.5,68.5 27,72 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M81,36 Q68.5,39.5 56,44 L56,64 Q68.5,68.5 81,72 Z" />
</vector>
