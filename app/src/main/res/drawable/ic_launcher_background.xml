<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's backdrop: a diagonal gradient from the brand teal into a deep blue.

  A `shape` rather than a vector, because an adaptive icon's background layer is full bleed and gets
  masked into whatever shape the launcher uses — there is nothing to draw but a field of colour, and
  a gradient rectangle cannot be got wrong. The deep blue at the far corner is what stops the icon
  reading as "a teal app" at a glance: the 54-to-0 degree tilt gives the mark a light source, so the
  white book on top looks lit rather than printed flat.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:endColor="#0B3B52"
        android:startColor="#12796B"
        android:type="linear" />
</shape>
