<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand mark: an open book, and nothing else.

  **The shape.** Two facing pages meeting at a straight spine: the glyph an open-book mark is
  built from, stripped to its plainest expression — no ribbon, no watermark, no gradient, nothing
  alongside the book. Each page falls from a high outer corner to the spine, so the spread reads
  as a book laid open rather than two cards side by side; the two halves are mirror images, so
  the mark is symmetric without being static.

  **Material 3 / adaptive-icon compliance.** The foreground and the monochrome layer are each a
  single 108dp vector, drawn straight into the full adaptive-icon canvas: no inset wrapper, no
  scaled-down "safe" sub-canvas, so every mask the system composes reads the mark at its intended
  size. Everything that carries the silhouette sits inside the 66dp safe-zone circle about the
  canvas centre: the extreme path points are (27,36), (81,36), (81,72) and (27,72) — radius
  √(27²+18²) ≈ 32.4 < 33 — so no launcher mask, however aggressive, cuts the book. There is no
  raster asset at any density; the same two paths serve every tier.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left page. The outer edge runs straight down from (27,36) to (27,72); the curve is the
         page's own sag towards the binding. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,36 Q39.5,39.5 52,44 L52,64 Q39.5,68.5 27,72 Z" />

    <!-- Right page: the same path reflected about the centre line, leaving a four-unit spine. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M81,36 Q68.5,39.5 56,44 L56,64 Q68.5,68.5 81,72 Z" />
</vector>
