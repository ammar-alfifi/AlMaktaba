<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand mark: an open book, and nothing else.

  The icon used to carry three things — a *rub el hizb* watermark, the book, and an amber ribbon —
  which is a composition, not a mark. A launcher icon is read at 48dp from arm's length, and at that
  size a watermark is grime and a ribbon is a smudge; what survives is one bold silhouette. So this
  is the book on its own, in flat white, on a flat ground.

  **The shape.** Two pages meeting at a narrow spine, each curving down towards it — the one line
  that says "open book" rather than "two cards side by side". The outer edge of each page is twice
  the height of the spine edge, which is what gives the spread its tilt; the pages are otherwise
  mirror images, so the mark reads as symmetric without being static.

  Everything sits inside a 32.4-radius circle about the centre of the 108-unit viewport: the
  outermost corner is at (27, 36), which is √(27² + 18²) away, comfortably inside the 33-radius
  circle that no launcher mask cuts. Drawn as vectors, so no raster asset is needed at any density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left page. The outer edge runs straight from (27,36) to (27,72); the spine edge is the
         shorter pair, so the page narrows as it falls towards the binding. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,36 Q39.5,39.5 52,44 L52,64 Q39.5,68.5 27,72 Z" />

    <!-- Right page: the same path reflected about the centre line, leaving a four-unit spine. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M81,36 Q68.5,39.5 56,44 L56,64 Q68.5,68.5 81,72 Z" />
</vector>
