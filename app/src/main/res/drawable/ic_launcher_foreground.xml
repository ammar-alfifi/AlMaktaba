<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand mark: an open book on an eight-pointed star.

  The star is the *rub el hizb* — two overlapping squares, the geometric mark that has framed Arabic
  manuscripts for a thousand years — drawn as two low-opacity paths so it reads as a watermark
  behind the book rather than as a competing shape. It carries the app's identity at large sizes and
  fades to a soft glow at 48dp, which is the behaviour wanted from a backdrop.

  Everything sits inside the adaptive icon's safe zone: the star's points reach a radius of 31 and
  the book's outer corners about 30, both inside the 33-radius circle that no launcher mask cuts.

  Drawn as vectors, so the launcher icon needs no raster assets at any density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rub el hizb: square 1, axis aligned. Drawn as a soft watermark — a fill faint enough to
         read as light rather than as a second shape, with just enough of an edge to survive being
         scaled down to a launcher's 48dp. -->
    <path
        android:fillColor="#21FFFFFF"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="1"
        android:pathData="M32,32 L76,32 L76,76 L32,76 Z" />

    <!-- Rub el hizb: square 2, rotated 45°. -->
    <path
        android:fillColor="#21FFFFFF"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="1"
        android:pathData="M54,23 L85,54 L54,85 L23,54 Z" />

    <!-- Left page, slightly dipped so the spread has a light direction. -->
    <path
        android:fillColor="#EAF2EF"
        android:pathData="M53,42 C47,37 39,34.5 29,36.5 L29,70 C39,68 47,70.5 53,75 Z" />

    <!-- Right page, full white: it faces the gradient's light. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,42 C61,37 69,34.5 79,36.5 L79,70 C69,68 61,70.5 55,75 Z" />

    <!-- Amber ribbon bookmark, hanging over the right page's outer edge. -->
    <path
        android:fillColor="#FFC46B"
        android:pathData="M64,44.5 L73,46 L73,63.5 L68.5,59.8 L64,62.8 Z" />
</vector>
